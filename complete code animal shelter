# ---- Locate this script's own folder ------------------------------------
# No hardcoded paths: this finds the folder the .R file itself lives in,
# so the script works for anyone as long as the three raw CSVs sit in the
# SAME folder as this .R file. Works when sourced, run via Rscript, or run
# interactively in Positron/RStudio.
get_script_dir <- function() {
  # Case 1: run non-interactively via `Rscript file.R` or `R -f file.R`
  cmd_args <- commandArgs(trailingOnly = FALSE)
  file_arg <- grep("^--file=", cmd_args, value = TRUE)
  if (length(file_arg) > 0) {
    return(dirname(normalizePath(sub("^--file=", "", file_arg[1]))))
  }

  # Case 2: running interactively in RStudio or Positron (this covers both
  # sourcing the file and running it line-by-line/with "Run")
  if (requireNamespace("rstudioapi", quietly = TRUE) &&
      tryCatch(rstudioapi::isAvailable(), error = function(e) FALSE)) {
    active_path <- tryCatch(rstudioapi::getSourceEditorContext()$path, error = function(e) "")
    if (nzchar(active_path)) {
      return(dirname(normalizePath(active_path)))
    }
  }

  # Fallback: current working directory (set this manually if detection fails)
  getwd()
}

