  block_test(sex_fixed_lm, breed_lm, "Breed family after age and sex controls"),
  block_test(breed_lm, full_structured_lm, "Color family after breed"),
  block_test(full_structured_lm, full_interaction_lm, "Region-by-age-group interaction after all controls")
