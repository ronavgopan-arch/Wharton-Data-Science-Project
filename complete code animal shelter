austin_dogs <- austin_raw %>%
  filter(Type == "Dog") %>%
  mutate(
    outcome_dt = parse_austin_datetime(`Outcome Date`),
    intake_dt = parse_austin_datetime(`Intake Date`),
    birth_dt = parse_austin_datetime(`Date of Birth`),
    stay_days = as.numeric(difftime(outcome_dt, intake_dt, units = "days")),
    age_years = as.numeric(difftime(outcome_dt, birth_dt, units = "days")) / 365.25,
    age_years = if_else(age_years >= 0 & age_years <= 25, age_years, NA_real_),
    outcome_group = make_outcome_group(`Outcome Status`),
    fixed_status = case_when(
      str_to_lower(`Spayed/Neutered`) == "yes" ~ "Spayed/Neutered",
      str_to_lower(`Spayed/Neutered`) == "no" ~ "Not spayed/neutered",
      TRUE ~ "Unknown"
    )
  ) %>%
  filter(!is.na(outcome_dt), !is.na(intake_dt), stay_days >= 0) %>%
  transmute(
    region = "Austin, TX",
    intake_dt = as_date(intake_dt),
    outcome_dt = as_date(outcome_dt),
    stay_days,
    age_years,
    outcome_group,
    adopted = outcome_group == "Adoption",
    sex_group = case_when(
      str_detect(str_to_lower(Sex), "female") ~ "Female",
      str_detect(str_to_lower(Sex), "male") ~ "Male",
      TRUE ~ "Unknown"
    ),
    fixed_status,
    breed_family = make_breed_family_simple(`Primary Breed`),
    color_family = make_color_family_simple(standardize_color(`Primary Color`))
  )

