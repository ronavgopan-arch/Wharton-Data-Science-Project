find_one_csv <- function(dir, pattern) {
  matches <- list.files(dir, pattern = pattern, ignore.case = TRUE, full.names = TRUE)
  matches <- matches[!grepl("adopted_model_data\\.csv$", matches)]
  if (length(matches) == 0) {
    return(NA_character_)
  }
  # If multiple matches, prefer the most recently modified file.
  if (length(matches) > 1) {
    matches <- matches[order(file.info(matches)$mtime, decreasing = TRUE)]
  }
  matches[1]
}

