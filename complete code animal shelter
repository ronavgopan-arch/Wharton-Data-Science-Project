all_dogs_all_periods <- bind_rows(austin_dogs, norfolk_dogs, louisville_dogs) %>%
  mutate(
    region = factor(region, levels = c("Austin, TX", "Norfolk, VA", "Louisville, KY")),
    outcome_group = factor(outcome_group),
    breed_family = factor(
      breed_family,
      levels = c("Other", "Pit Bull / Staffy", "Retriever", "Shepherd", "Small Companion", "Working / Large", "Hound / Beagle")
    ),
    color_family = factor(
      color_family,
      levels = c("Other", "Black", "White", "Brown", "Tan/Cream", "Gray/Blue", "Red/Orange", "Patterned")
    )
  )

date_ranges <- all_dogs_all_periods %>%
  group_by(region) %>%
  summarize(
    cleaned_dog_records = n(),
    min_outcome_date = min(outcome_dt),
    max_outcome_date = max(outcome_dt),
    .groups = "drop"
  )

common_start <- max(date_ranges$min_outcome_date)
common_end <- min(date_ranges$max_outcome_date)

shared_period_all_outcomes <- all_dogs_all_periods %>%
  filter(outcome_dt >= common_start, outcome_dt <= common_end) %>%
  mutate(
    log_stay = log1p(stay_days),
    age_group = make_age_group(age_years),
    intake_month = factor(as.character(month(intake_dt, label = TRUE, abbr = TRUE)), levels = month.abb),
    sex_group = factor(sex_group, levels = c("Female", "Male", "Unknown")),
    fixed_status = factor(fixed_status, levels = c("Not spayed/neutered", "Spayed/Neutered", "Unknown"))
  ) %>%
  drop_na(log_stay, intake_month, sex_group, fixed_status, breed_family, color_family)

