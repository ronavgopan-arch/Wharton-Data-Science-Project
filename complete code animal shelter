block_test <- function(reduced_model, full_model, label) {
  test_result <- anova(reduced_model, full_model)

  tibble(
    test = label,
    added_df = test_result$Df[2],
    added_sum_squares = test_result$`Sum of Sq`[2],
    f_statistic = test_result$F[2],
    p_value = test_result$`Pr(>F)`[2]
  )
}

