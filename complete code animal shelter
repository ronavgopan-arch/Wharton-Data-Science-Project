cumulative_adoption_counts <- age_all_outcome_data %>%
  filter(adopted) %>%
  select(region, age_group, stay_days) %>%
  uncount(weights = length(adoption_day_intervals), .id = "interval_id") %>%
  mutate(day_threshold = adoption_day_intervals[interval_id]) %>%
  filter(stay_days <= day_threshold) %>%
  count(region, age_group, day_threshold, name = "adopted_by_day")

cumulative_age_adoption <- expand_grid(
  region = levels(age_all_outcome_data$region),
  age_group = levels(age_all_outcome_data$age_group),
  day_threshold = adoption_day_intervals
) %>%
  mutate(
    region = factor(region, levels = levels(age_all_outcome_data$region)),
    age_group = factor(age_group, levels = levels(age_all_outcome_data$age_group))
  ) %>%
  left_join(age_time_denominators, by = c("region", "age_group")) %>%
  left_join(cumulative_adoption_counts, by = c("region", "age_group", "day_threshold")) %>%
  mutate(
    adopted_by_day = replace_na(adopted_by_day, 0L),
    cumulative_adoption_probability = adopted_by_day / all_age_known_records,
    conditional_adoption_speed = adopted_by_day / adopted_records
  )

