parse_austin_datetime <- function(x) {
  parse_date_time(
    x,
    orders = c(
      "Y b d I:M:S p",
      "Y B d I:M:S p",
      "Y-m-d H:M:S",
      "Y-m-d"
    ),
    quiet = TRUE
  )
}

standardize_color <- function(color) {
  color %>%
    str_squish() %>%
    str_to_title() %>%
    str_replace_all("\\s*/\\s*", " / ") %>%
    str_replace_all(regex("Grey", ignore_case = TRUE), "Gray") %>%
    str_replace_all(regex("Tri[- ]?Color", ignore_case = TRUE), "Tricolor") %>%
    str_replace_all(regex("Br Brindle", ignore_case = TRUE), "Brown Brindle") %>%
    na_if("Unknown")
}

make_breed_family_simple <- function(breed) {
  breed_lower <- str_to_lower(breed)

  case_when(
    str_detect(breed_lower, "pit bull|am pit|american staff|staffordshire") ~ "Pit Bull / Staffy",
    str_detect(breed_lower, "labrador|lab retr|golden retr|retriever") ~ "Retriever",
    str_detect(breed_lower, "shepherd|shepard") ~ "Shepherd",
    str_detect(breed_lower, "chihuahua|shih tzu|yorkshire|poodle|maltese") ~ "Small Companion",
    str_detect(breed_lower, "husky|boxer|rottweiler|doberman") ~ "Working / Large",
    str_detect(breed_lower, "beagle|hound") ~ "Hound / Beagle",
    TRUE ~ "Other"
  )
}

make_color_family_simple <- function(color) {
  color_lower <- str_to_lower(color)

  case_when(
    str_detect(color_lower, "black") ~ "Black",
    str_detect(color_lower, "white") ~ "White",
    str_detect(color_lower, "brown|chocolate") ~ "Brown",
    str_detect(color_lower, "tan|fawn|buff|cream") ~ "Tan/Cream",
    str_detect(color_lower, "gray|blue|silver") ~ "Gray/Blue",
    str_detect(color_lower, "red|orange|yellow") ~ "Red/Orange",
    str_detect(color_lower, "brindle|tricolor|tri") ~ "Patterned",
    TRUE ~ "Other"
  )
}

make_outcome_group <- function(outcome) {
  outcome_lower <- str_to_lower(outcome)

  case_when(
    str_detect(outcome_lower, "adopt") ~ "Adoption",
    str_detect(outcome_lower, "transfer|rescue") ~ "Transfer",
    str_detect(outcome_lower, "\\brto\\b|return|reclaim|owner") ~ "Return to Owner",
    str_detect(outcome_lower, "euth") ~ "Euthanasia",
    str_detect(outcome_lower, "died|dead") ~ "Died",
    TRUE ~ "Other"
  )
}

make_age_group <- function(age_years) {
  cut(
    age_years,
    breaks = c(-Inf, 0.5, 2, 7, Inf),
    labels = c("Puppy (<6 months)", "Young (6 months-2 years)", "Adult (2-7 years)", "Senior (7+ years)")
  )
}

most_common <- function(x) {
  x <- x[!is.na(x)]
  names(sort(table(x), decreasing = TRUE))[1]
}

rmse <- function(actual, predicted) {
  sqrt(mean((actual - predicted)^2, na.rm = TRUE))
}

mae <- function(actual, predicted) {
  mean(abs(actual - predicted), na.rm = TRUE)
}

