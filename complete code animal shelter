prediction_formula <- long_stay ~ age_years + region + intake_month +
  sex_group + fixed_status + breed_family + color_family

prediction_terms <- delete.response(terms(prediction_formula))

safe_divide <- function(numerator, denominator) {
  if (is.na(denominator) || denominator == 0) {
    return(NA_real_)
  }

  numerator / denominator
}

calculate_auc <- function(actual, probability) {
  actual_numeric <- as.integer(actual)

  if (length(unique(actual_numeric)) < 2) {
    return(NA_real_)
  }

  ranks <- rank(probability, ties.method = "average")
  n_positive <- sum(actual_numeric == 1)
  n_negative <- sum(actual_numeric == 0)

  (sum(ranks[actual_numeric == 1]) - n_positive * (n_positive + 1) / 2) /
    (n_positive * n_negative)
}

calculate_classification_metrics <- function(actual, probability, model_name, seed) {
  probability <- pmin(pmax(probability, 1e-6), 1 - 1e-6)
  actual_numeric <- as.integer(actual)
  actual_positive <- actual_numeric == 1
  predicted_positive <- probability >= 0.5

  true_positive <- sum(predicted_positive & actual_positive)
  true_negative <- sum(!predicted_positive & !actual_positive)
  false_positive <- sum(predicted_positive & !actual_positive)
  false_negative <- sum(!predicted_positive & actual_positive)

  tibble(
    seed = seed,
    model = model_name,
    test_records = length(actual_numeric),
    long_stay_rate = mean(actual_positive),
    accuracy = mean(predicted_positive == actual_positive),
    sensitivity = safe_divide(true_positive, true_positive + false_negative),
    specificity = safe_divide(true_negative, true_negative + false_positive),
    precision = safe_divide(true_positive, true_positive + false_positive),
    auc = calculate_auc(actual_positive, probability),
    log_loss = -mean(
      actual_numeric * log(probability) +
        (1 - actual_numeric) * log(1 - probability)
    ),
    brier_score = mean((probability - actual_numeric)^2)
  )
}

build_design_matrix <- function(data) {
  model.matrix(prediction_terms, data = data)[, -1, drop = FALSE]
}

align_design_matrix <- function(matrix_raw, reference_columns) {
  matrix_raw <- as.matrix(matrix_raw)
  missing_columns <- setdiff(reference_columns, colnames(matrix_raw))

  if (length(missing_columns) > 0) {
    missing_matrix <- matrix(
      0,
      nrow = nrow(matrix_raw),
      ncol = length(missing_columns),
      dimnames = list(NULL, missing_columns)
    )
    matrix_raw <- cbind(matrix_raw, missing_matrix)
  }

  matrix_raw[, reference_columns, drop = FALSE]
}

standardize_with_training <- function(matrix_raw, training_means, training_sds) {
  sweep(
    sweep(matrix_raw, 2, training_means, "-"),
    2,
    training_sds,
    "/"
  )
}

create_prediction_split <- function(data, seed, train_prop = 0.7) {
  set.seed(seed)

  train_ids <- data %>%
    mutate(row_id = row_number()) %>%
    group_by(long_stay) %>%
    slice_sample(prop = train_prop) %>%
    ungroup() %>%
    pull(row_id)

  list(
    train = data %>% slice(train_ids),
    test = data %>% slice(setdiff(seq_len(nrow(data)), train_ids))
  )
}

fit_prediction_models <- function(seed) {
  split_data <- create_prediction_split(nn_model_data, seed)
  train_data <- split_data$train
  test_data <- split_data$test

  train_x_raw <- build_design_matrix(train_data)
  test_x_raw <- align_design_matrix(
    build_design_matrix(test_data),
    colnames(train_x_raw)
  )

  training_means <- colMeans(train_x_raw)
  training_sds <- apply(train_x_raw, 2, sd)
  training_sds[is.na(training_sds) | training_sds == 0] <- 1

  train_x <- standardize_with_training(train_x_raw, training_means, training_sds)
  test_x <- standardize_with_training(test_x_raw, training_means, training_sds)
  train_y <- as.integer(train_data$long_stay)

  logistic_fit <- suppressWarnings(
    glm.fit(
      x = cbind(intercept = 1, train_x),
      y = train_y,
      family = binomial()
    )
  )
  logistic_coefficients <- coef(logistic_fit)
  logistic_coefficients[is.na(logistic_coefficients)] <- 0
  logistic_probability <- as.numeric(
    plogis(cbind(intercept = 1, test_x) %*% logistic_coefficients)
  )

  set.seed(seed + 1000)
  neural_fit <- nnet::nnet(
    x = train_x,
    y = train_y,
    size = 4,
    decay = 0.01,
    maxit = 500,
    entropy = TRUE,
    trace = FALSE,
    MaxNWts = 10000
  )
  neural_probability <- as.numeric(
    predict(neural_fit, test_x, type = "raw")
  )

  bind_rows(
    calculate_classification_metrics(
      test_data$long_stay,
      logistic_probability,
      "Logistic regression baseline",
      seed
    ),
    calculate_classification_metrics(
      test_data$long_stay,
      neural_probability,
      "Neural network",
      seed
    )
  )
}

